DATABASE_URL=postgresql://postgres:postgres@postgres:5432/infrashelf
# At least 32 characters, or every login fails. Generate: openssl rand -base64 48
JWT_SECRET=change-this-to-a-random-secret-min-32-chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
# Encrypts the TOTP second-factor secrets at rest. 32 bytes, hex or base64:
#   openssl rand -base64 32
# Blank = derived from JWT_SECRET, which works but ties the two together:
# rotating JWT_SECRET then makes every enrolled authenticator unreadable.
TOTP_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:3000
# Session lifetimes in seconds (issue #37); blank = 8 h, and 30 days with
# "remember me". Both are clamped to 30 days.
SESSION_TTL_SECONDS=
SESSION_REMEMBER_ME_TTL_SECONDS=
# Trust X-Forwarded-For. Only with a reverse proxy you control: it sets the
# per-IP login rate-limit bucket AND the address shown in the session list.
TRUST_PROXY=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=noreply@example.com
SMTP_USER=
SMTP_PASS=
SMTP_TLS=true
EXCHANGE_RATE_API_URL=https://api.exchangerate.host/latest

# Enables POST /api/internal/decommission-sweep (see ../../.env.example).
# Blank = the sweep endpoint is disabled (503).
DECOMMISSION_SWEEP_SECRET=

# Shared secret for the scheduled drift loop (#108), sent as X-Drift-Secret.
# Authorises BOTH halves of the cycle:
#   GET  /api/internal/drift-targets   the work list the pipeline asks for
#   POST /api/internal/drift-report    what `plan -refresh-only` concluded
# Blank = both are disabled (503). See ../../.env.example for the full note.
DRIFT_REPORT_SECRET=

# Shared secret for the deployment-window sweep (#330).
#
# An approved order that arrives outside a deployment window waits in
# 'scheduled' with the instant it may run. Nothing releases it on its own — the
# backend runs several replicas, so an in-process timer would fire once per
# replica and provision the same order that many times. Point a scheduler at
# POST /api/internal/deployment-window-sweep with this value in X-Sweep-Secret.
#
# Blank leaves the endpoint disabled (503). WITHOUT a scheduler calling it, a
# scheduled order waits for ever — the same trap the decommission sweep has.
# Also authorises POST /api/internal/holiday-refresh (#330), which pulls the
# holiday feed into the database. Same feature, same operator, one secret.
DEPLOYMENT_WINDOW_SWEEP_SECRET=
# AES-256-GCM key for every stored credential (issue #111):
#   - the external-system integration registry (Foreman, Ansible, Nexus, Pulp,
#     Loki, Grafana)
#   - CI source access tokens
# Exactly 64 hex characters: openssl rand -hex 32
# Blank = neither can be stored; those endpoints answer 503 rather than writing
# plain text. CI tokens already in the database stay plain text until this is
# set, and are encrypted once at the next boot.
# Not rotatable in place: a new key cannot decrypt what the old one wrote.
# Leaving it blank is warned about at boot (#414) — the server still starts.
SECRET_ENCRYPTION_KEY=

# ── Security keys / passkeys (issue #197) ─────────────────────────────────────
# WebAuthn is scoped to a Relying Party, and the browser signs the assertion over
# the origin it is actually on. Getting these wrong is the one failure that works
# perfectly on localhost and breaks every key on the deployed instance — the same
# shape as #196 — so the backend validates them the first time a WebAuthn
# ceremony runs (`resolveRp`) and refuses with a message naming the variable,
# rather than letting the browser fail silently later.
#
# Note WHEN: on first use, not at boot. A misconfigured instance starts, serves
# every other page, and only reports this when someone tries to register or use a
# key — so check it deliberately after a deploy rather than waiting to be told.
#
#   WEBAUTHN_RP_ID     a BARE DOMAIN. No scheme, no port, no path.
#                      portal.example.com — or example.com to let a credential
#                      work across subdomains.
#   WEBAUTHN_RP_ORIGIN the full origin the browser sees, WITH scheme and port.
#                      https://portal.example.com. Comma-separate several if the
#                      deployment answers on more than one hostname; the RP ID has
#                      to be a suffix of every one of them.
#
# Left blank they default to localhost, which is what makes a fresh clone work
# with a key straight away. Both are REQUIRED when NODE_ENV=production; the
# backend refuses to start a ceremony without them rather than issuing
# credentials nobody can use.
#
# Changing WEBAUTHN_RP_ID invalidates every registered credential — they are
# scoped to it. Moving the portal to a new domain means everyone re-registers
# their key, so pick the broadest domain you might want before anyone enrols.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_ORIGIN=

# ── Demo data ─────────────────────────────────────────────────────────────────
# `make db-seed-demo` refuses to run with NODE_ENV=production: it writes a
# catalogue, a CI source and two environments that are not real. Set this to 1
# only if that is genuinely what you want on this database.
#
# The credentials it writes are generated, not literals — an earlier version
# wrote `demo-callback-1`, and a callback secret an attacker can type is a
# pipeline callback an attacker can forge (#147).
ALLOW_DEMO_SEED_IN_PRODUCTION=

# Where the demo catalogue points its CI source and webhook URLs.
#
# Blank means `https://gitlab.example.invalid` — reserved by RFC 2606 so it can
# never resolve, which is what keeps a development seed from reaching a real CI
# system by accident. It also means NO PIPELINE STACK is seeded: a stack makes a
# product provisionable, provisioning fires a trigger the moment an order is
# placed, and against `.invalid` that trigger fails and the order is refused.
#
# Set it to something that answers and the seed adds a stack. The e2e job points
# it at the WireMock in infra/wiremock/mappings, which is what makes the
# provisioning journey runnable (#157):
#
#   DEMO_CI_URL=http://localhost:8080
DEMO_CI_URL=

# Permit plaintext http to a CI host that is not loopback.
#
# Every outbound call to a GitLab carries a credential — the trigger token on a
# pipeline trigger, PRIVATE-TOKEN on every read — so an `http://` CI source puts
# all of it on the wire in clear (#329). The portal refuses that by default.
#
# Loopback needs no flag: the WireMock the e2e suite points DEMO_CI_URL at
# speaks http on :8080 and never leaves the machine.
#
# Set to 1 only for an on-premise CI genuinely reachable only over http, on a
# network you trust. GitHub and Bitbucket are unaffected — those clients always
# talk to api.github.com and api.bitbucket.org over https.
ALLOW_INSECURE_CI_TRANSPORT=
