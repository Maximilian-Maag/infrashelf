# Dependencies
# No trailing slash, deliberately. `node_modules/` matches a DIRECTORY only, so
# a symlink of that name slips straight past it — which is what happens the
# moment anyone runs `git worktree add` and links the dependencies in rather
# than installing them again. `git add -A` then commits the links, and CI dies
# on `ENOTDIR: not a directory, mkdir '.../node_modules'` in `pnpm install`,
# several confusing steps away from the cause.
node_modules
apps/*/node_modules
packages/*/node_modules

# Next.js build output
apps/*/.next/
apps/*/out/
.next/

# Mutation-testing sandboxes (Stryker copies the source tree per run) and the
# HTML reports the runs write to apps/<app>/reports/mutation/
.stryker-tmp/
apps/*/.stryker-tmp/
reports/mutation/
apps/*/reports/mutation/

# Agent worktrees (an isolated checkout per background agent). Deliberately narrow:
# a project's own .claude/settings.json is worth committing, a scratch checkout is not.
.claude/worktrees/

# TypeScript incremental build cache
*.tsbuildinfo

# Environment variables — .env.example is committed, .env is not
.env
apps/**/.env
infra/docker-host/.env

# TLS certificates
infra/docker-host/certs/
*.pem
*.key
*.crt
*.p12
*.pfx

# Test and coverage output
coverage/
coverage.out
coverage.html

# Playwright auth state (generated by auth.setup.ts, contains session tokens)
e2e/.auth/

# Go build artifacts (legacy binary at repo root)
/server
/migrate

# Structurizr Lite generated cache
docs/architecture/.structurizr/
docs/architecture/workspace.json

# The compiled handbook is not committed — `make handbook` builds it locally,
# CI compiles it on PRs that touch handbook.tex and uploads it as a build
# artifact, and the release workflow attaches a freshly-built copy to each
# GitHub Release. See README.md ("Technical Handbook").
docs/handbook.pdf

# LaTeX auxiliary files
docs/handbook.aux
docs/handbook.log
docs/handbook.out
docs/handbook.toc
docs/handbook.lof
docs/handbook.lot
docs/handbook.lol
docs/handbook.fls
docs/handbook.fdb_latexmk
docs/handbook.synctex.gz

# IDE
.idea/
.vscode/*
!.vscode/launch.json
*.swp
*.swo
*.swn
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# Playwright
test-results/
playwright-report/

# The pinned opa binary for `make policy` (50 MB, fetched by `make policy-install-opa`)
# Same reason as node_modules above: no trailing slash.
.opa

# Pinned diagram tooling (see scripts/diagramTools.ts) and its scratch output.
.diagrams
# Generated from docs/architecture/workspace.dsl by `make diagrams`. Not
# committed, for the same reason handbook.pdf is not: a checked-in rendering
# drifts from the model the moment nobody regenerates it, and the model is the
# source of truth. `make handbook` regenerates them first.
docs/architecture/diagrams/

# Per-developer mise overrides. `mise.toml` is the committed pin that everyone
# and CI agree on (see scripts/toolchain.test.ts); these are the local escape
# hatch for trying another Node without changing what the repository claims.
mise.local.toml
.mise.local.toml
.mise/
